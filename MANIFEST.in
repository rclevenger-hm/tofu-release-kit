include LICENSE README.md HISTORY.md CONTRIBUTING.md SECURITY.md RELEASE_NOTES.md Makefile
recursive-include src *.py *.rego
recursive-include tests *.py *.json *.rego
recursive-include scripts *.py *.sh
recursive-include docs *.md
recursive-include integrations *.md
recursive-include examples *.tf *.tftest.hcl *.toml *.example
include examples/aws-serverless/.terraform.lock.hcl
include examples/aws-serverless/app/handler.py
include examples/recovery-local/README.md
prune examples/aws-serverless/.terraform
prune examples/aws-serverless/.artifacts
global-exclude __pycache__ *.py[cod]
